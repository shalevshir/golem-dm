# Copy to .env. Loaded automatically by `pnpm dev`/`pnpm start` via Node's
# --env-file-if-exists (package.json), then validated by src/config.ts at
# boot — a missing provider key fails the process rather than the first turn.

PORT=3000
LOG_LEVEL=info

# At least one is required. Which one depends on ModelRouting (see
# packages/agents/src/providers/routing.ts); the SDKs read these directly.
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
GOOGLE_GENERATIVE_AI_API_KEY=

# Not yet used — the event store is in-memory until the persistence spec.
# DATABASE_URL=postgres://aidm:aidm@localhost:5432/aidm
